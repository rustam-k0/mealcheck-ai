TELEGRAM_BOT_TOKEN=123456789:replace_me

# OpenCode Go provides an OpenAI-compatible Chat Completions endpoint.
AI_API_KEY=replace_me
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_PROVIDER=opencode-go
AI_VISION_MODEL=mimo-v2-omni
AI_TEXT_MODEL=mimo-v2-omni
# Catalog syntax: model|capability+capability. Plain names mean text+image.
AI_MODEL_CATALOG=mimo-v2-omni|text+image,glm-5.2|text,kimi-k3|text

# Optional. Leave unset to run photo and text flows without voice input.
# AI_TRANSCRIPTION_MODEL=transcription-model
# TRANSCRIPTION_API_KEY=replace_me
# TRANSCRIPTION_BASE_URL=https://transcription-gateway.example/v1

ALLOWED_USERS=123456789,987654321
ADMIN_USERS=123456789
# WEBHOOK_URL=https://bot.example.com
PORT=8080
# REDIS_URL=redis://localhost:6379/0
DIARY_DB_PATH=banana_mate_diary.sqlite3
REQUEST_TIMEOUT_SECONDS=180
CONNECT_TIMEOUT_SECONDS=10
HTTP_RETRIES=2
RATE_LIMIT_PER_MINUTE=20
MAX_OUTPUT_TOKENS=1800
MEMORY_MESSAGES=8
LOG_LEVEL=INFO
